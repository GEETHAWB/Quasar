{
    "version": 6,
    "configurePresets": [
        {
            "name": "ninja-debug",
            "displayName": "Ninja Debug",
            "description": "Configure a Debug build with Ninja.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ninja-release",
            "displayName": "Ninja Release",
            "description": "Configure a Release build with Ninja.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-ninja-debug",
            "configurePreset": "ninja-debug"
        },
        {
            "name": "build-ninja-release",
            "configurePreset": "ninja-release"
        }
    ]
}
